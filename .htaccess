# ── Cache control ────────────────────────────────────────────
# Images and audio: 30 days (these rarely change once published)
# JS and CSS: 7 days (may update between deploys)
# HTML: no-cache (always fetch fresh so template/content changes appear immediately)
# Fonts + favicon: correct types; filenames are fixed, so a change needs a rename
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType image/x-icon .ico

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType audio/mpeg "access plus 30 days"
    ExpiresByType audio/wav "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|mp3|wav)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "(\.woff2|^favicon\.(ico|svg))$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

RewriteEngine On

# Redirect old /writing/ URLs to /poems/
RewriteRule ^writing/(.*)$ /poems/$1 [R=301,L]

# Redirect old /albums/ URLs to /releases/
RewriteRule ^albums/(.*)$ /releases/$1 [R=301,L]

# Poem pages: /poems/works-event.html -> /poems-template.html?id=works-event
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^poems/([^/]+)\.html$ /poems-template.html?id=$1 [L,QSA]

# Song pages: /songs/bad-fortune.html -> /song-template.html?id=bad-fortune
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^songs/([^/]+)\.html$ /song-template.html?id=$1 [L,QSA]

# Release pages: /releases/hard-hitter.html -> /release-template.html?id=hard-hitter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^releases/([^/]+)\.html$ /release-template.html?id=$1 [L,QSA]

# ── Private data: never serve ───────────────────────────────
<FilesMatch "^(subscribers\.csv|subscribe_log\.txt)$">
    Require all denied
</FilesMatch>

# ── Test demos + unreleased audio: never serve (files stay in git) ──
<FilesMatch "^(the-most-generic-experience-ever|old-enough-to-handle-it|late-stage-capitalismz)\.mp3$">
    Require all denied
</FilesMatch>
# whole jets to oblivia folder until that album is out
<If "%{REQUEST_URI} =~ m#^/audio/jets-to-oblivia/#">
    Require all denied
</If>

# ── "Don't count me": cookie set by ?me=1 (js/status.js) ────
# The Pi's vhost config uses this env var to log these requests to me_access.log.
# (IfModule: without mod_setenvif a bare SetEnvIf would 500 the whole site)
<IfModule mod_setenvif.c>
    SetEnvIf Cookie "rt_me=1" rt_me
</IfModule>
